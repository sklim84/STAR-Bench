__pycache__/
.pytest_cache/
*.py[cod]
**/logs/
.DS_Store
.vscode/
.idea/
.env
.env.*
results_repro/
results/
results_en/
checkpoint/
eval/
*.jsonl
_manuscript/KFinEval_figures/
_backup/

# Everything under _experiments/runs/ ships with the benchmark: the run records,
# the scores derived from them and the manifests beside them. The rules above
# exclude `eval/`, `checkpoint/` and `*.jsonl` by name, and a file cannot be
# re-included while a parent directory is excluded, so each level is named here.
!_experiments/runs/
!_experiments/runs/**/
!_experiments/runs/**/*.json
!_experiments/runs/**/*.jsonl

# 실험 로그는 추적하지 않음 (옵션 A — 비민감 실행/오케스트레이션 로그, 레포에서 제외).
# 상단 **/logs/ 규칙이 _experiments/logs/ 도 무시.

# 아카이브된(무효/구버전) 결과 — 추적 제외
_excluded/
**/_excluded/

# internal audit and coordination material lives in the manuscript repository
_experiments/dataset_fix_20260915/

# The preflight writes its report every run; the artefact travels with the run,
# not with the repository.
_experiments/scripts/preflight/reports/

# Scoring logs travel with the run, not with the repository; the eval JSON beside
# them is the artefact.
_experiments/runs/eval*/**/*.log
# Unpacked archives handed over between hosts; their records are already under
# _experiments/runs/.
_experiments/coauthor*_handover_x/
_experiments/coauthor*_handover.zip


# Expert evaluation working files. The first round carried a rater name and is not
# released. The second round carries slots (A, B) and no names, and its code-to-model
# key is no longer blind once rating is done, so it is released for Appendix F.
_experiments/human_eval/*
!_experiments/human_eval/round2/

# The generated LaTeX tables are written here by regenerate_analysis and copied into
# the manuscript; they are an output of the released scripts, not a released artefact.
_experiments/paper_tables/
